{
	"name": "@alessiofrittoli/html-to-pdf",
	"version": "1.1.0",
	"description": "Easily convert HTML to PDF",
	"type": "module",
	"author": {
		"name": "Alessio Frittoli",
		"email": "info@alessiofrittoli.it",
		"url": "https://alessiofrittoli.it"
	},
	"license": "MIT",
	"funding": [
		{
			"type": "github",
			"url": "https://github.com/sponsors/alessiofrittoli"
		}
	],
	"keywords": [
		"nodejs",
		"npm",
		"pdf"
	],
	"homepage": "https://github.com/alessiofrittoli/html-to-pdf#readme",
	"bugs": {
		"url": "https://github.com/alessiofrittoli/html-to-pdf/issues",
		"email": "info@alessiofrittoli.it"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alessiofrittoli/html-to-pdf.git"
	},
	"engines": {
		"node": ">=24.15.0",
		"pnpm": ">=11.27.1"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./*": {
			"import": {
				"types": "./dist/*/index.d.mts",
				"default": "./dist/*/index.mjs"
			},
			"require": {
				"types": "./dist/*/index.d.cts",
				"default": "./dist/*/index.cjs"
			}
		}
	},
	"sideEffects": false,
	"scripts": {
		"//1a": "*********************************************************************",
		"//1b": "******************** DEV - BUILD - LINT - RELEASE *******************",
		"//1c": "*********************************************************************",
		"dev": "tsdown --watch",
		"build": "pnpm lint && pnpm tsdown",
		"lint": "oxlint --report-unused-disable-directives --max-warnings 0",
		"release": "node scripts/release.ts --verbose --npm",
		"//2a": "*********************************************************************",
		"//2b": "***************************** UNIT TESTS ****************************",
		"//2c": "*********************************************************************",
		"test": "vitest --reporter=tree",
		"test:watch": "pnpm test watch",
		"test:ci": "pnpm test run",
		"//3a": "*********************************************************************",
		"//3b": "************************ UNIT TESTS COVERAGE ************************",
		"//3c": "*********************************************************************",
		"test:coverage": "pnpm test:watch --coverage",
		"test:coverage:ci": "pnpm test:ci --coverage",
		"test:serve-coverage": "http-server ./coverage --gzip true -p 0 -o /index.html --silent",
		"test:coverage:serve": "concurrently --prefix none --kill-others \"pnpm test:coverage\" \"pnpm test:serve-coverage\""
	},
	"peerDependencies": {
		"@alessiofrittoli/crypto-buffer": "^3.12.0",
		"@alessiofrittoli/stream-reader": "^3.3.0",
		"@alessiofrittoli/url-utils": "^4.2.0",
		"bufferutil": "^4.1.0",
		"inline-css": "^4.0.3",
		"puppeteer": "^24.34.0"
	},
	"devDependencies": {
		"@alessiofrittoli/crypto-buffer": "^3.12.0",
		"@alessiofrittoli/node-scripts": "^4.2.0",
		"@alessiofrittoli/package-configs": "^1.14.1",
		"@alessiofrittoli/stream-reader": "^3.3.0",
		"@alessiofrittoli/stream-writer": "^1.6.0",
		"@alessiofrittoli/url-utils": "^4.2.0",
		"@types/inline-css": "^3.0.4",
		"@types/node": "^24.19.2",
		"@vitest/coverage-v8": "^5.1.0",
		"bufferutil": "^4.1.0",
		"concurrently": "^10.0.7",
		"http-server": "^14.1.1",
		"inline-css": "^4.0.3",
		"oxlint": "^1.93.0",
		"oxlint-tsgolint": "^7.0.2007",
		"prettier": "^3.10.1",
		"prettier-plugin-sort-imports": "^1.8.11",
		"puppeteer": "^24.34.0",
		"tsdown": "^0.23.7",
		"typescript": "^6.0.3",
		"vitest": "^5.1.0"
	}
}
